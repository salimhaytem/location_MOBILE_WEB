generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PERSONNEL
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  RENTED
}

enum Transmission {
  AUTO
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IncidentType {
  DAMAGE
  ACCIDENT
  MECHANICAL
}

enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  RESOLVED
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  role         Role      @default(CLIENT)
  firstName    String
  lastName     String
  phone        String?
  pushToken    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      Profile?
  reservations Reservation[] @relation("UserReservations")
  checkins     CheckIn[]     @relation("AgentCheckins")
  checkouts    CheckOut[]    @relation("AgentCheckouts")
  incidents    Incident[]    @relation("AgentIncidents")
  reviews      Review[]
}

model Profile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address               String?
  city                  String?
  country               String?
  postalCode            String?
  drivingLicenseNumber  String?
  drivingLicenseExpiry  DateTime?
  idCardNumber          String?
  idCardExpiry          DateTime?
  avatarUrl             String?
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
}

model Category {
  id            String     @id @default(uuid())
  name          String     @unique
  description   String?
  basePricePerDay Float
  vehicles      Vehicle[]
}

model Vehicle {
  id              String         @id @default(uuid())
  brand           String
  model           String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  registrationNumber String      @unique
  year            Int
  color           String
  transmission    Transmission
  fuelType        FuelType
  doors           Int
  seats           Int
  luggage         Int
  pricePerDay     Float
  pricePerKm      Float         @default(0.5)
  deposit         Float
  mileage         Int           @default(0)
  status          VehicleStatus @default(AVAILABLE)
  images          String[]
  description     String?
  features        String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  reservations    Reservation[]
  incidents       Incident[]
  maintenance     Maintenance[]
}

model Reservation {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation("UserReservations", fields: [userId], references: [id])
  vehicleId        String
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  agentId          String?
  pickupDate       DateTime
  returnDate       DateTime
  pickupLocation   String
  returnLocation   String
  status           ReservationStatus @default(PENDING)
  totalPrice       Float
  depositAmount    Float
  depositPaid      Boolean           @default(false)
  insurance        Boolean           @default(false)
  gps              Boolean           @default(false)
  babySeat         Boolean           @default(false)
  notes            String?
  stripePaymentId  String?
  paymentMethod    String?           @default("CASH")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  checkin          CheckIn?
  checkout         CheckOut?
  reviews          Review[]
}

model CheckIn {
  id              String   @id @default(uuid())
  reservationId   String   @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  agentId         String
  agent           User     @relation("AgentCheckins", fields: [agentId], references: [id])
  pickupDateTime  DateTime
  vehicleCondition String?
  kmAtPickup      Int
  fuelLevelPickup Float
  notes           String?
  signature       String?
  createdAt       DateTime @default(now())
}

model CheckOut {
  id              String   @id @default(uuid())
  reservationId   String   @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  agentId         String
  agent           User     @relation("AgentCheckouts", fields: [agentId], references: [id])
  returnDateTime  DateTime
  vehicleCondition String?
  kmAtReturn      Int
  fuelReturnLevel Float
  additionalCharges Float  @default(0)
  notes           String?
  signature       String?
  createdAt       DateTime @default(now())
}

model Incident {
  id           String         @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id])
  reservationId String?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  agentId      String
  agent        User           @relation("AgentIncidents", fields: [agentId], references: [id])
  type         IncidentType
  description  String
  photos       String[]
  status       IncidentStatus @default(REPORTED)
  adminNote    String?
  estimatedCost Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  rating        Int
  comment       String?
  response      String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Maintenance {
  id          String           @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id])
  type        MaintenanceType
  description String
  cost        Float?
  startDate   DateTime
  endDate     DateTime?
  status      MaintenanceStatus @default(SCHEDULED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}