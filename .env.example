# =============================================================================
# CARLOC - Variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et configurez les valeurs selon votre environnement

# =============================================================================
# BASE DE DONNÉES
# =============================================================================
# URL de connexion PostgreSQL
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carloc?schema=public"

# =============================================================================
# AUTHENTIFICATION JWT
# =============================================================================
# Secret pour signer les tokens JWT (minimum 32 caractères)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# Durée de validité du token d'accès
JWT_EXPIRES_IN="7d"
# Secret pour les tokens de rafraîchissement
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars"
# Durée de validité du token de rafraîchissement
JWT_REFRESH_EXPIRES_IN="30d"

# =============================================================================
# STRIPE - Paiements par carte bancaire
# =============================================================================
# Clé secrète Stripe (mode test: sk_test_...)
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
# Secret pour les webhooks Stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
# Clé publique Stripe pour le frontend
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# =============================================================================
# SENDGRID - Envoi d'emails transactionnels
# =============================================================================
# Clé API SendGrid
SENDGRID_API_KEY=""
# Email expéditeur par défaut
FROM_EMAIL="noreply@carloc.ma"
# Nom de l'expéditeur
FROM_NAME="CarLoc"

# =============================================================================
# AWS S3 - Stockage des fichiers (photos, factures)
# =============================================================================
# Clé d'accès AWS
AWS_ACCESS_KEY_ID=""
# Clé secrète AWS
AWS_SECRET_ACCESS_KEY=""
# Nom du bucket S3
AWS_BUCKET_NAME="carloc-files"
# Région AWS
AWS_REGION="eu-west-3"

# =============================================================================
# RÈGLES MÉTIER
# =============================================================================
# Kilomètres inclus par jour de location
KM_INCLUDED_PER_DAY=200
# Prix par kilomètre supplémentaire (MAD)
PRICE_PER_EXTRA_KM=2
# Timeout pour les réservations CASH en attente (minutes)
CASH_RESERVATION_TIMEOUT_MINUTES=30
# Heures avant départ pour annulation gratuite
CANCEL_FREE_HOURS=48
# Heures avant départ pour annulation partielle (50%)
CANCEL_PARTIAL_HOURS=24
# Pourcentage de pénalité pour annulation partielle
CANCEL_PARTIAL_PENALTY=0.5
# Montant du dépôt/caution par défaut (MAD)
DEPOSIT_AMOUNT_DEFAULT=2000

# =============================================================================
# URLs
# =============================================================================
# URL du frontend web
FRONTEND_URL="http://localhost:3000"
# URL du backend API
BACKEND_URL="http://localhost:4000"
# URL de l'API pour les apps mobiles (Expo)
EXPO_PUBLIC_API_URL="http://localhost:4000"

# =============================================================================
# AGENCE - Informations utilisées dans les factures
# =============================================================================
AGENCY_NAME="CarLoc"
AGENCY_ADDRESS="123 Rue Mohammed V, Casablanca"
AGENCY_PHONE="+212 522 123 456"
AGENCY_EMAIL="contact@carloc.ma"